# Backend configuration for local/dev and for hosts like Render.
#
# Local (quick start):
DATABASE_URL=sqlite:///./app.db
#
# Persistent (recommended for beta):
# Example Postgres URL from a provider like Neon/Supabase (note `sslmode=require`):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1
# Increase these if you see "max_tokens / output limit reached" errors.
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_MAX_OUTPUT_TOKENS_RETRY=1400
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://glockstock.github.io
JWT_SECRET_KEY=change-me
