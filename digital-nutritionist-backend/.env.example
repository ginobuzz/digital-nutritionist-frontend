# Backend configuration for local/dev and for hosts like Render.
#
# Environment name (used to prevent unsafe defaults on hosted deployments).
# - Local dev: leave as-is
# - Hosted beta/prod: set to "beta" or "production"
APP_ENV=development
#
# Local (quick start):
DATABASE_URL=sqlite:///./app.db
#
# Persistent (recommended for beta):
# Example Postgres URL from Neon (note `sslmode=require`):
# - Prefer the "pooled" host if you're using serverless / short-lived instances (contains "pooler" in host)
# - Prefer the "direct" host for long-lived servers if you want normal pooling
#
# Direct:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx.us-east-2.aws.neon.tech/DBNAME?sslmode=require
# Pooled (PgBouncer):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxxx-pooler.us-east-2.aws.neon.tech/DBNAME?sslmode=require
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.1
# Increase these if you see "max_tokens / output limit reached" errors.
OPENAI_MAX_OUTPUT_TOKENS=900
OPENAI_MAX_OUTPUT_TOKENS_RETRY=1400
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://glockstock.github.io
JWT_SECRET_KEY=change-me
# Token lifetime (in minutes). Default is 30 days.
JWT_EXP_MINUTES=43200
