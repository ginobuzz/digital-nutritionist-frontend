{
  "name": "digital-nutritionist-frontend",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://glockstock.github.io/digital-nutritionist-frontend",
  "dependencies": {
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/system": "^7.2.0",
    "@mui/x-date-pickers": "^8.10.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "date-fns": "^4.1.0",
    "markdown-to-jsx": "^9.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "react-scripts": "5.0.1",
    "recharts": "^3.1.0",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "node scripts/build-with-metadata.js start",
    "build": "node scripts/build-with-metadata.js build",
    "build:cap": "cross-env PUBLIC_URL=. node scripts/build-with-metadata.js build",
    "test": "craco test",
    "test:ci": "cross-env CI=true craco test --watchAll=false",
    "test:staged": "cross-env CI=true craco test --findRelatedTests --passWithNoTests",
    "test:coverage": "cross-env CI=true craco test --watchAll=false --coverage",
    "test:api": "node scripts/test-api-connection.js",
    "test:smoke": "node scripts/smoke-test.js",
    "eject": "react-scripts eject",
    "prepare": "husky install",
    "cap:sync": "npx cap sync",
    "cap:sync:ios": "npx cap sync ios",
    "cap:sync:ios:remote": "cross-env CAPACITOR_USE_BUNDLED_WEB=false npx cap sync ios",
    "cap:sync:ios:bundled": "cross-env CAPACITOR_USE_BUNDLED_WEB=true npx cap sync ios",
    "cap:sync:android": "npx cap sync android",
    "cap:sync:android:remote": "cross-env CAPACITOR_USE_BUNDLED_WEB=false npx cap sync android",
    "cap:sync:android:bundled": "cross-env CAPACITOR_USE_BUNDLED_WEB=true npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "ios:icons": "node scripts/generate-ios-icon-variants.js",
    "ios": "npm run cap:sync:ios:remote && npm run cap:open:ios",
    "ios:bundled": "npm run build:cap && npm run cap:sync:ios:bundled && npm run cap:verify:ios && npm run cap:open:ios",
    "android": "npm run cap:sync:android:remote && npm run cap:open:android",
    "android:bundled": "npm run build:cap && npm run cap:sync:android:bundled && npm run cap:verify:android && npm run cap:open:android",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "cap:verify:ios": "node scripts/verify-capacitor-sync.js ios",
    "cap:verify:android": "node scripts/verify-capacitor-sync.js android",
    "ios:refresh": "npm run build:cap && npm run cap:sync:ios:bundled && npm run cap:verify:ios",
    "android:refresh": "npm run build:cap && npm run cap:sync:android:bundled && npm run cap:verify:android"
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/development/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "npm run test:staged --"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@craco/craco": "^7.1.0",
    "cross-env": "^7.0.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "@capacitor/android": "^8.1.0"
  }
}
